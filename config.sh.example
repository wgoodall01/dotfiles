#!/usr/bin/env bash

export CFG_SSH=false      # Enable SSH key decryption?
export CFG_PUSHOVER=false # Decrypt the Pushover CLI config?

# Crypto password for SSH keys and sensitive info
export CRYPTO_PW=""

# NOTE: Language runtimes and CLIs are no longer configured with flags here.
# They're pinned declaratively in links/.config/mise/config.toml, which init.sh
# symlinks to ~/.config/mise/config.toml and installs with `mise install`.
